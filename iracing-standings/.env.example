# Leave IRACING_MOCK=1 until iRacing issues your OAuth client.
IRACING_MOCK=1

# OAuth client issued by iRacing staff (password_limited grant).
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=

# The iRacing account the tool logs in as. Needs an active subscription.
IRACING_USERNAME=
IRACING_PASSWORD=

PORT=3000
# Minutes to cache standings responses. Standings only change after each session.
CACHE_TTL_MINUTES=10
